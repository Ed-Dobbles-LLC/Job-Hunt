# ============================================================
# Job Match Automation System - Environment Variables
# ============================================================
# Copy this to .env and fill in your values.

# ---- PostgreSQL Database ----
# Required. Connection string for your PostgreSQL database.
DATABASE_URL=postgresql://user:password@host:5432/jobmatch

# ---- OpenAI API ----
# Required. Your OpenAI API key for GPT-4o resume/cover letter generation.
OPENAI_API_KEY=sk-...
# Optional. Override the base URL (e.g., for Azure OpenAI).
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Gmail API (Direct - recommended) ----
# Get these from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token

# ---- Gmail Label ----
# The Gmail label where job alert emails are filed.
GMAIL_LABEL=Job Alerts

# ---- Email Digest Recipient ----
# Where to send the daily digest email.
DIGEST_EMAIL=you@example.com

# ---- Scheduling ----
# Cron expression for daily workflow run (default: 12:30 PM UTC).
SCHEDULE_CRON_EXPRESSION=30 12 * * *

# ---- Inngest ----
# Required for workflow orchestration. Get from https://inngest.com
INNGEST_EVENT_KEY=your-event-key
INNGEST_SIGNING_KEY=your-signing-key

# ---- Clay Enrichment (Optional) ----
# Webhook URL for Clay company/contact enrichment.
# CLAY_WEBHOOK_URL=https://api.clay.com/v3/sources/webhook/...

# ---- API Import Key ----
# API key for the /api/import-emails endpoint (generate a random string).
IMPORT_API_KEY=generate-a-random-hex-string

# ---- Public URL (for production deployment) ----
# Set to your deployed URL so Inngest can reach the app.
# PUBLIC_URL=https://your-app.railway.app

# ---- Workspace Root (Optional) ----
# Override the root directory for output files. Defaults to cwd.
# WORKSPACE_ROOT=/app

# ---- Testing ----
# Set to "true" to use fixture emails instead of live Gmail.
# USE_FIXTURES=false
